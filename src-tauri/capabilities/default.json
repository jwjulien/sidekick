{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "window-state:default",
    "deep-link:default",
    "barcode-scanner:default",
    "nfc:default",
    "nfc:allow-is-available",
    "nfc:allow-scan",
    "nfc:allow-write"
  ]
}
